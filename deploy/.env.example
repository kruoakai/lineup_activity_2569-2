# deploy/.env ถูกสร้างอัตโนมัติโดย install.sh (สุ่มรหัสผ่านและ secret ให้)
# ไฟล์นี้แสดงค่าทั้งหมดที่ระบบรองรับ — ห้ามนำ .env จริงขึ้น Git
DOMAIN=lineup.example.ac.th
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
QR_SECRET=

# รหัสผ่านเริ่มต้นของครูที่นำเข้าใหม่ / รีเซ็ต (ต้องเปลี่ยนเมื่อเข้าครั้งแรก)
INITIAL_PASSWORD=12345678

# อีเมล (ไม่บังคับ) — เปิดลืมรหัสผ่านและแจ้งเตือนผู้ลงนาม
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ระบบเช็กชื่อเข้าแถว <no-reply@example.ac.th>

# เข้าสู่ระบบด้วย LINE (ไม่บังคับ) — ดู INSTALL.md
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=

# น้องแถวดี — AI ผู้ช่วยตอบคำถาม (OpenRouter) เว้นว่าง = ปิดผู้ช่วย
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5   # ประหยัดกว่า: anthropic/claude-haiku-5.5
