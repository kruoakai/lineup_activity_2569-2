deploy/.env
deploy/keys/
deploy/certs/
deploy/letsencrypt/
deploy/certbot-www/
deploy/.seeded

# ---------- ห้ามขึ้น Git: ข้อมูลส่วนบุคคล ----------
backend/data/personnel.json
initial-passwords.csv
*.csv
*.xlsx
backend/uploads/
deploy/backups/
# รูปลายเซ็น/รูปบุคคลที่วางไว้ในโฟลเดอร์หลัก
/*.png
/*.jpg

